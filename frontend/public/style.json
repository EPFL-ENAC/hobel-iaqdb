{
  "version": 8,
  "name": "Light Style",
  "sources": {
    "osm": {
      "type": "raster",
      "tiles": ["https://tile.osm.ch/osm-swiss-style/{z}/{x}/{y}.png"],
      "tileSize": 256,
      "minzoom": 0,
      "maxzoom": 20
    }
  },
  "glyphs": "https://orangemug.github.io/font-glyphs/glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "light",
      "type": "raster",
      "source": "osm",
      "paint": {
        "raster-saturation": -0.9,
        "raster-brightness-min": 0.5
      }
    }
  ]
}
